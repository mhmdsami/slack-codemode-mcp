{
  "name": "slack-codemode-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "slack-codemode-mcp": "./mcp/server.mjs",
    "slack-codemode-auth": "./scripts/auth.mjs",
    "slack-codemode-doctor": "./scripts/check.mjs"
  },
  "files": [
    "mcp/",
    "src/",
    "celld/",
    "scripts/auth.mjs",
    "scripts/check.mjs",
    "docs/",
    "allowlist.json",
    "api-index.json",
    "INSTALLATION.md",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node mcp/server.mjs",
    "auth": "node scripts/auth.mjs",
    "doctor": "node scripts/check.mjs",
    "generate": "node scripts/generate-api.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "node --test",
    "gate": "biome check . && node --test",
    "scopes": "node scripts/auth.mjs --scopes"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@slack/web-api": "^7.11.0",
    "lefthook": "^2.2.2",
    "typescript": "^5.9.3"
  },
  "description": "Code Mode MCP server for Slack, executed in a sandboxed celld V8 isolate.",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhmdsami/slack-codemode-mcp.git"
  },
  "homepage": "https://github.com/mhmdsami/slack-codemode-mcp#readme",
  "bugs": {
    "url": "https://github.com/mhmdsami/slack-codemode-mcp/issues"
  }
}
